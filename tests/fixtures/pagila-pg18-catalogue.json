"schema" : "public", "name" : "actor_info", "sql" : " SELECT a.actor_id,\n    a.first_name,\n    a.last_name,\n    jsonb_object_agg(c.name, ( SELECT array_agg(f.title) AS array_agg\n           FROM film f\n             JOIN film_category fc_1 ON f.film_id = fc_1.film_id\n             JOIN film_actor fa_1 ON f.film_id = fa_1.film_id\n          WHERE fc_1.category_id = c.category_id AND fa_1.actor_id = a.actor_id\n          GROUP BY fa_1.actor_id)) FILTER (WHERE c.name IS NOT NULL) AS film_info\n   FROM actor a\n     LEFT JOIN film_actor fa ON a.actor_id = fa.actor_id\n     LEFT JOIN film_category fc ON fa.film_id = fc.film_id\n     LEFT JOIN category c ON fc.category_id = c.category_id\n  GROUP BY a.actor_id, a.first_name, a.last_name;"}, {"schema" : "public", "name" : "customer_list", "sql" : " SELECT cu.customer_id AS id,\n    (cu.first_name || ' '::text) || cu.last_name AS name,\n    a.address,\n    a.postal_code AS \"zip code\",\n    a.phone,\n    city.city,\n    country.country,\n        CASE\n            WHEN cu.activebool THEN 'active'::text\n            ELSE ''::text\n        END AS notes,\n    cu.store_id AS sid\n   FROM customer cu\n     JOIN address a ON cu.address_id = a.address_id\n     JOIN city ON a.city_id = city.city_id\n     JOIN country ON city.country_id = country.country_id;"}, {"schema" : "public", "name" : "film_list", "sql" : " SELECT film.film_id AS fid,\n    film.title,\n    film.description,\n    category.name AS category,\n    film.rental_rate AS price,\n    film.length,\n    film.rating,\n    group_concat((actor.first_name || ' '::text) || actor.last_name) AS actors\n   FROM category\n     LEFT JOIN film_category ON category.category_id = film_category.category_id\n     LEFT JOIN film ON film_category.film_id = film.film_id\n     JOIN film_actor ON film.film_id = film_actor.film_id\n     JOIN actor ON film_actor.actor_id = actor.actor_id\n  GROUP BY film.film_id, film.title, film.description, category.name, film.rental_rate, film.length, film.rating;"}, {"schema" : "public", "name" : "nicer_but_slower_film_list", "sql" : " SELECT film.film_id AS fid,\n    film.title,\n    film.description,\n    category.name AS category,\n    film.rental_rate AS price,\n    film.length,\n    film.rating,\n    group_concat(((upper(\"substring\"(actor.first_name, 1, 1)) || lower(\"substring\"(actor.first_name, 2))) || upper(\"substring\"(actor.last_name, 1, 1))) || lower(\"substring\"(actor.last_name, 2))) AS actors\n   FROM category\n     LEFT JOIN film_category ON category.category_id = film_category.category_id\n     LEFT JOIN film ON film_category.film_id = film.film_id\n     JOIN film_actor ON film.film_id = film_actor.film_id\n     JOIN actor ON film_actor.actor_id = actor.actor_id\n  GROUP BY film.film_id, film.title, film.description, category.name, film.rental_rate, film.length, film.rating;"}, {"schema" : "public", "name" : "rental_by_category", "sql" : " SELECT c.name AS category,\n    sum(p.amount) AS total_sales\n   FROM payment p\n     JOIN rental r ON p.rental_id = r.rental_id\n     JOIN inventory i ON r.inventory_id = i.inventory_id\n     JOIN film f ON i.film_id = f.film_id\n     JOIN film_category fc ON f.film_id = fc.film_id\n     JOIN category c ON fc.category_id = c.category_id\n  GROUP BY c.name\n  ORDER BY (sum(p.amount)) DESC;"}, {"schema" : "public", "name" : "sales_by_film_category", "sql" : " SELECT c.name AS category,\n    sum(p.amount) AS total_sales\n   FROM payment p\n     JOIN rental r ON p.rental_id = r.rental_id\n     JOIN inventory i ON r.inventory_id = i.inventory_id\n     JOIN film f ON i.film_id = f.film_id\n     JOIN film_category fc ON f.film_id = fc.film_id\n     JOIN category c ON fc.category_id = c.category_id\n  GROUP BY c.name\n  ORDER BY (sum(p.amount)) DESC;"}, {"schema" : "public", "name" : "sales_by_store", "sql" : " SELECT (c.city || ','::text) || cy.country AS store,\n    (m.first_name || ' '::text) || m.last_name AS manager,\n    sum(p.amount) AS total_sales\n   FROM payment p\n     JOIN rental r ON p.rental_id = r.rental_id\n     JOIN inventory i ON r.inventory_id = i.inventory_id\n     JOIN store s ON i.store_id = s.store_id\n     JOIN address a ON s.address_id = a.address_id\n     JOIN city c ON a.city_id = c.city_id\n     JOIN country cy ON c.country_id = cy.country_id\n     JOIN staff m ON s.manager_staff_id = m.staff_id\n  GROUP BY cy.country, c.city, s.store_id, m.first_name, m.last_name\n  ORDER BY cy.country, c.city;"}, {"schema" : "public", "name" : "staff_list", "sql" : " SELECT s.staff_id AS id,\n    (s.first_name || ' '::text) || s.last_name AS name,\n    a.address,\n    a.postal_code AS \"zip code\",\n    a.phone,\n    city.city,\n    country.country,\n    s.store_id AS sid\n   FROM staff s\n     JOIN address a ON s.address_id = a.address_id\n     JOIN city ON a.city_id = city.city_id\n     JOIN country ON city.country_id = country.country_id;"}], "triggers" : [{"schema" : "public", "table" : "film_actor", "name" : "last_updated", "timing" : "BEFORE", "event" : "UPDATE", "body" : "CREATE TRIGGER last_updated BEFORE UPDATE ON film_actor FOR EACH ROW EXECUTE FUNCTION last_updated()"}, {"schema" : "public", "table" : "address", "name" : "last_updated", "timing" : "BEFORE", "event" : "UPDATE", "body" : "CREATE TRIGGER last_updated BEFORE UPDATE ON address FOR EACH ROW EXECUTE FUNCTION last_updated()"}, {"schema" : "public", "table" : "city", "name" : "last_updated", "timing" : "BEFORE", "event" : "UPDATE", "body" : "CREATE TRIGGER last_updated BEFORE UPDATE ON city FOR EACH ROW EXECUTE FUNCTION last_updated()"}, {"schema" : "public", "table" : "actor", "name" : "last_updated", "timing" : "BEFORE", "event" : "UPDATE", "body" : "CREATE TRIGGER last_updated BEFORE UPDATE ON actor FOR EACH ROW EXECUTE FUNCTION last_updated()"}, {"schema" : "public", "table" : "category", "name" : "last_updated", "timing" : "BEFORE", "event" : "UPDATE", "body" : "CREATE TRIGGER last_updated BEFORE UPDATE ON category FOR EACH ROW EXECUTE FUNCTION last_updated()"}, {"schema" : "public", "table" : "country", "name" : "last_updated", "timing" : "BEFORE", "event" : "UPDATE", "body" : "CREATE TRIGGER last_updated BEFORE UPDATE ON country FOR EACH ROW EXECUTE FUNCTION last_updated()"}, {"schema" : "public", "table" : "customer", "name" : "last_updated", "timing" : "BEFORE", "event" : "UPDATE", "body" : "CREATE TRIGGER last_updated BEFORE UPDATE ON customer FOR EACH ROW EXECUTE FUNCTION last_updated()"}, {"schema" : "public", "table" : "film", "name" : "last_updated", "timing" : "BEFORE", "event" : "UPDATE", "body" : "CREATE TRIGGER last_updated BEFORE UPDATE ON film FOR EACH ROW EXECUTE FUNCTION last_updated()"}, {"schema" : "public", "table" : "film", "name" : "film_fulltext_trigger", "timing" : "BEFORE", "event" : "INSERT OR UPDATE", "body" : "CREATE TRIGGER film_fulltext_trigger BEFORE INSERT OR UPDATE ON film FOR EACH ROW EXECUTE FUNCTION tsvector_update_trigger('fulltext', 'pg_catalog.english', 'title', 'description')"}, {"schema" : "public", "table" : "film_category", "name" : "last_updated", "timing" : "BEFORE", "event" : "UPDATE", "body" : "CREATE TRIGGER last_updated BEFORE UPDATE ON film_category FOR EACH ROW EXECUTE FUNCTION last_updated()"}, {"schema" : "public", "table" : "inventory", "name" : "last_updated", "timing" : "BEFORE", "event" : "UPDATE", "body" : "CREATE TRIGGER last_updated BEFORE UPDATE ON inventory FOR EACH ROW EXECUTE FUNCTION last_updated()"}, {"schema" : "public", "table" : "language", "name" : "last_updated", "timing" : "BEFORE", "event" : "UPDATE", "body" : "CREATE TRIGGER last_updated BEFORE UPDATE ON language FOR EACH ROW EXECUTE FUNCTION last_updated()"}, {"schema" : "public", "table" : "rental", "name" : "last_updated", "timing" : "BEFORE", "event" : "UPDATE", "body" : "CREATE TRIGGER last_updated BEFORE UPDATE ON rental FOR EACH ROW EXECUTE FUNCTION last_updated()"}, {"schema" : "public", "table" : "store", "name" : "last_updated", "timing" : "BEFORE", "event" : "UPDATE", "body" : "CREATE TRIGGER last_updated BEFORE UPDATE ON store FOR EACH ROW EXECUTE FUNCTION last_updated()"}, {"schema" : "public", "table" : "staff", "name" : "last_updated", "timing" : "BEFORE", "event" : "UPDATE", "body" : "CREATE TRIGGER last_updated BEFORE UPDATE ON staff FOR EACH ROW EXECUTE FUNCTION last_updated()"}]}
