{"format":"joinscope-catalogue","version":1,"dialect":"oracle","database":"HR","tables":[{"table":"PROJECT_MEMBERS","rows":1,"comment":null},{"table":"LOCATIONS","rows":23,"comment":"Locations table that contains specific address of a specific office,\nwarehouse, and/or production site of a company. Does not store addresses /\nlocations of customers. references with the departments and countries tables. "},{"table":"EMPLOYEES","rows":107,"comment":"employees table. References with departments,\njobs, job_history tables. Contains a self reference."},{"table":"JOB_HISTORY","rows":10,"comment":"Table that stores job history of the employees. If an employee\nchanges departments within the job or changes jobs within the department,\nnew rows get inserted into this table with old job information of the\nemployee. Contains a complex primary key: employee_id+start_date.\nReferences with jobs, employees, and departments tables."},{"table":"COUNTRIES","rows":25,"comment":"country table. References with locations table."},{"table":"JOBS","rows":19,"comment":"jobs table with job titles and salary ranges.\nReferences with employees and job_history table."},{"table":"REGIONS","rows":5,"comment":"Regions table that contains region numbers and names. references with the Countries table."},{"table":"PROJECTS","rows":2,"comment":"Work done for a department; one row per project"},{"table":"PROJECT_NOTES","rows":0,"comment":null},{"table":"DEPARTMENTS","rows":27,"comment":"Departments table that shows details of departments where employees\nwork. references with locations, employees, and job_history tables."}],"columns":[{"table":"COUNTRIES","column":"COUNTRY_ID","position":1,"type":"CHAR(2)","nullable":false,"default":null,"auto":false,"generated":false,"comment":"Primary key of countries table."},{"table":"COUNTRIES","column":"COUNTRY_NAME","position":2,"type":"VARCHAR2(60)","nullable":true,"default":null,"auto":false,"generated":false,"comment":"Country name"},{"table":"COUNTRIES","