false,"generated":false,"comment":"First name of the employee. A not null column."},{"table":"EMPLOYEES","column":"LAST_NAME","position":3,"type":"VARCHAR2(25)","nullable":false,"default":null,"auto":false,"generated":false,"comment":"Last name of the employee. A not null column."},{"table":"EMPLOYEES","column":"EMAIL","position":4,"type":"VARCHAR2(25)","nullable":false,"default":null,"auto":false,"generated":false,"comment":"Email id of the employee"},{"table":"EMPLOYEES","column":"PHONE_NUMBER","position":5,"type":"VARCHAR2(20)","nullable":true,"default":null,"auto":false,"generated":false,"comment":"Phone number of the employee; includes country code and area code"},{"table":"EMPLOYEES","column":"HIRE_DATE","position":6,"type":"DATE","nullable":false,"default":null,"auto":false,"generated":false,"comment":"Date when the employee started on this job. A not null column."},{"table":"EMPLOYEES","column":"JOB_ID","position":7,"type":"VARCHAR2(10)","nullable":false,"default":null,"auto":false,"generated":false,"comment":"Current job of the employee; foreign key to job_id column of the\njobs table. A not null column."},{"table":"EMPLOYEES","column":"SALARY","position":8,"type":"NUMBER(8,2)","nullable":true,"default":null,"auto":false,"generated":false,"comment":"Monthly salary of the employee. Must be greater\nthan zero (enforced by constraint emp_salary_min)"},{"table":"EMPLOYEES","column":"COMMISSION_PCT","position":9,"type":"NUMBER(2,2)","nullable":true,"default":null,"auto":false,"generated":false,"comment":"Commission percentage of the employee; Only employees in sales\ndepartment eligible for commission percentage"},{"table":"EMPLOYEES","column":"MANAGER_ID","position":10,"type":"NUMBER(6,0)","nullable":true,"default":null,"auto":false,"generated":false,"comment":"Manager id of the employee; has same domain as manager_id in\ndepartments table. Foreign key to employee_id column of employees table.\n(useful for reflexive joins and CONNECT BY query)"},{"table":"EMPLOYEES","column":"DEPARTMENT_ID","position":11,"type":"NUMBER(4,0)","nullable":true,"default":null,"auto":false,"generated":false,"comment":"Department id where employee works; foreign key to department_id\ncolumn of the departments table"},{"table":"JOB_HISTORY","column":"EMPLOYEE_ID","position":1,"type":"NUMBER(6,0)","nullable":false,"default":null,"auto":false,"generated":false,"comment":"A not null column in the complex primary key employee_id+start_date.\nForeign key to employee_id column of the employee table"},{"table":"JOB_HISTORY","column":"START_DATE","position":2,"type":"DATE","nullable":false,"default":null,"auto":false,"generated":false,"comment":"A not null column in the complex primary key employee_id+start_date.\nMust be less than the end_date of the job_history table. (enforced by\nconstraint jhist_date_interval)"},{"table":"JOB_HISTORY","column":"END_DATE","position":3,"type":"DATE","nullable":false,"default":null,"auto":false,"generated":false,"comment":"Last day of the employee in this job role. A not null column. Must be\ngreater than the start_date of the job_history table.\n(enforced by constraint jhist_date_interval)"},{"table":"JOB_HISTORY","column":"JOB_ID","position":4,"type":"VARCHAR2(10)","nullable":false,"default":null,"auto":false,"generated":false,"comment":"Job role in which the employee worked in the past; foreign key to\njob_id column in the jobs table. A not null column."},{"table":"JOB_HISTORY","column":"DEPARTMENT_ID","position":5,"type":"NUMBER(4,0)","nullable":true,"default":null,"auto":false,"generated":false,"comment":"Department id in which the employee worked in the past; foreign key to department_id column in the departments table"},{"table":"PROJECT_MEMBERS","column":"PROJECT_ID","position":1,"type":"NUMBER","nullable":false,"default":null,"auto":false,"generated":false,"comment":null},{"table":"PROJECT_MEMBERS","column":"EMPLOYEE_ID","position":2,"type":"NUMBER(6,0)","nullable":false,"default":null,"auto":false,"generated