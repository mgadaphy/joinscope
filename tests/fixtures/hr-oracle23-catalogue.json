":"NORMAL","position":1,"column":"STATE_PROVINCE"},{"table":"LOCATIONS","name":"LOC_CITY_IX","unique":false,"type":"NORMAL","position":1,"column":"CITY"},{"table":"DEPARTMENTS","name":"DEPT_LOCATION_IX","unique":false,"type":"NORMAL","position":1,"column":"LOCATION_ID"},{"table":"EMPLOYEES","name":"EMP_NAME_IX","unique":false,"type":"NORMAL","position":1,"column":"LAST_NAME"},{"table":"EMPLOYEES","name":"EMP_NAME_IX","unique":false,"type":"NORMAL","position":2,"column":"FIRST_NAME"},{"table":"EMPLOYEES","name":"EMP_MANAGER_IX","unique":false,"type":"NORMAL","position":1,"column":"MANAGER_ID"},{"table":"EMPLOYEES","name":"EMP_JOB_IX","unique":false,"type":"NORMAL","position":1,"column":"JOB_ID"},{"table":"EMPLOYEES","name":"EMP_DEPARTMENT_IX","unique":false,"type":"NORMAL","position":1,"column":"DEPARTMENT_ID"},{"table":"EMPLOYEES","name":"EMP_EMAIL_UK","unique":true,"type":"NORMAL","position":1,"column":"EMAIL"},{"table":"JOB_HISTORY","name":"JHIST_DEPARTMENT_IX","unique":false,"type":"NORMAL","position":1,"column":"DEPARTMENT_ID"},{"table":"JOB_HISTORY","name":"JHIST_EMPLOYEE_IX","unique":false,"type":"NORMAL","position":1,"column":"EMPLOYEE_ID"},{"table":"JOB_HISTORY","name":"JHIST_JOB_IX","unique":false,"type":"NORMAL","position":1,"column":"JOB_ID"},{"table":"PROJECTS","name":"PROJECTS_DEPT_BIX","unique":false,"type":"BITMAP","position":1,"column":"DEPARTMENT_ID"},{"table":"PROJECTS","name":"PROJECTS_NAME_UK","unique":true,"type":"NORMAL","position":1,"column":"NAME"},{"table":"PROJECT_NOTES","name":"PROJECT_NOTES_UPPER_IX","unique":false,"type":"FUNCTION-BASED NORMAL","position":1,"column":"UPPER(TO_CHAR(SUBSTR(\"BODY\",1,50)))"}],"views":[{"name":"EMP_DETAILS_VIEW","sql":"SELECT\n  e.employee_id,\n  e.job_id,\n  e.manager_id,\n  e.department_id,\n  d.location_id,\n  l.country_id,\n  e.first_name,\n  e.last_name,\n  e.salary,\n  e.commission_pct,\n  d.department_name,\n  j.job_title,\n  l.city,\n	l.state_province,\n  c.country_name,\n	r.region_name\nFROM\n  employees e,\n  departments d,\n  jobs j,\n  locations l,\n  countries c,\n  regions r\nWHERE e.department_id = d.department_id\n  AND d.location_id = l.location_id\n  AND l.country_id = c.country_id\n  AND c.region_id = r.region_id\n  AND j.job_id = e.job_id\nWITH READ ONLY"},{"name":"PROJECT_STAFF","sql":"SELECT p.name, e.first_name, e.last_name, d.department_name\n  FROM projects p\n  JOIN project_members m ON m.project_id = p.project_id\n  JOIN employees e ON e.employee_id = m.employee_id\n  LEFT JOIN departments d ON d.department_id = p.department_id"}],"triggers":[{"name":"SECURE_EMPLOYEES","table":"EMPLOYEES","timing":"BEFORE","event":"INSERT OR UPDATE OR DELETE"},{"name":"UPDATE_JOB_HISTORY","table":"EMPLOYEES","timing":"AFTER","event":"UPDATE"},{"name":"PROJECTS_TOUCH","table":"PROJECTS","timing":"BEFORE","event":"INSERT OR UPDATE"}]}
